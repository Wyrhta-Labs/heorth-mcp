# Both upstreams are optional. With neither set, heorth-mcp still starts and
# serves an empty tool list.

# Heorth — the caller's own `Authorization: Bearer he_...` is forwarded verbatim,
# so no credential is configured here.
# HEORTH_BASE_URL=http://heorth:3000

# KithLedger — one `kl_` service key for the whole process (ADR 0002 Phase A).
# Required whenever KITH_BASE_URL is set.
# KITH_BASE_URL=http://kithledger:3000
# KITH_API_KEY=kl_...

# HTTP
PORT=3200
# UPSTREAM_TIMEOUT_MS=10000
