# Both upstreams are optional. With neither set, heorth-mcp still starts and
# serves an empty tool list.

# Heorth — the caller's own `Authorization: Bearer he_...` is forwarded verbatim,
# so no credential is configured here.
# HEORTH_BASE_URL=http://heorth:3000

# KithLedger — no credential here either. A `kith.*` call authenticates with a
# short-lived member token that heorth-mcp exchanges at Heorth
# (`POST /api/v1/auth/satellite-token`, ADR 0009), so HEORTH_BASE_URL is
# REQUIRED whenever KITH_BASE_URL is set — without it nothing could mint one.
# The old `KITH_API_KEY` service key is gone: KithLedger enforces per-member
# access control (ADR 0004) and no `kl_` key is the calling member.
# KITH_BASE_URL=http://kithledger:3000

# The satellite audience Heorth mints those tokens for. Must appear in Heorth's
# SATELLITE_AUDIENCES and match KithLedger's SATELLITE_AUDIENCE.
# KITH_AUDIENCE=kithledger

# HTTP
PORT=3200
# UPSTREAM_TIMEOUT_MS=10000
